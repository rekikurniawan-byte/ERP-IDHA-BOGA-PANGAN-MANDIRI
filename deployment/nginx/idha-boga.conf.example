server {
    listen 80;
    server_name domainanda.com www.domainanda.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name domainanda.com www.domainanda.com;

    # Isi otomatis oleh certbot/Let's Encrypt di server.
    ssl_certificate /etc/letsencrypt/live/domainanda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/domainanda.com/privkey.pem;

    client_max_body_size 6M;

    access_log /var/log/idha-boga/nginx-access.log;
    error_log /var/log/idha-boga/nginx-error.log;

    location /static/ {
        alias /opt/idha-boga/app/app/static/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Upload/bukti digital tidak di-serve langsung oleh Nginx.
    # Semua akses lampiran wajib lewat route Flask yang memakai login + role guard.

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 130s;
    }
}
