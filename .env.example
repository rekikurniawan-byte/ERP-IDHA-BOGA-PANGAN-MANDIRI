# ==================================================
# IDHA BOGA - LOCAL / STAGING POSTGRES-ONLY ENV EXAMPLE
# Copy to .env, then adjust values. Never commit real .env.
# ==================================================
APP_ENV=development
FLASK_ENV=development
APP_DEBUG=1
SECRET_KEY=change-this-local-secret-key

# POSTGRES-ONLY LOCK: SQLite fallback sudah dihapus. DATABASE_URL wajib PostgreSQL.
DATABASE_URL=postgresql+psycopg://idha_boga_user:IdhaBoga2026local@localhost:5432/idha_boga_staging

UPLOAD_ROOT=instance/uploads
DIGITAL_ATTACHMENT_UPLOAD_DIR=instance/uploads/digital_attachments
DIGITAL_ATTACHMENT_MAX_BYTES=5242880
DIGITAL_ATTACHMENT_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
BACKUP_ROOT=instance/backups
BACKUP_STORAGE_DIR=instance/backups
APP_BASE_URL=http://127.0.0.1:5000

SESSION_COOKIE_SECURE=0
LOGIN_RATE_LIMIT=5 per minute
RATELIMIT_STORAGE_URI=memory://
TRUSTED_HOSTS=

LOG_ROOT=instance/logs
APP_LOG_FILE=instance/logs/app.log
ERROR_LOG_FILE=instance/logs/error.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
SLOW_QUERY_LOGGING_ENABLED=1
SLOW_QUERY_THRESHOLD_MS=500
HEALTH_DISK_MIN_FREE_BYTES=1073741824
HEALTH_REQUIRE_VERIFIED_BACKUP=0
HEALTH_REQUIRE_POSTGRES_IN_PRODUCTION=1
PROXY_HEADERS_ENABLED=0
MAX_CONTENT_LENGTH=5242880
