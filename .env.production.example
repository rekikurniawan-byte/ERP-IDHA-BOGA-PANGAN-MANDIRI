# ==================================================
# IDHA BOGA - PRODUCTION POSTGRES-ONLY ENV EXAMPLE
# Copy on server only. Never commit real .env.production.
# ==================================================
APP_ENV=production
FLASK_ENV=production
APP_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret-key

# POSTGRES-ONLY LOCK: database production wajib PostgreSQL.
DATABASE_URL=postgresql+psycopg://idha_boga_user:replace-password@127.0.0.1:5432/idha_boga

UPLOAD_ROOT=/var/www/idha-boga/instance/uploads
DIGITAL_ATTACHMENT_UPLOAD_DIR=/var/www/idha-boga/instance/uploads/digital_attachments
DIGITAL_ATTACHMENT_MAX_BYTES=5242880
DIGITAL_ATTACHMENT_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
BACKUP_ROOT=/var/backups/idha-boga
BACKUP_STORAGE_DIR=/var/backups/idha-boga
APP_BASE_URL=https://domainanda.com

SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400
TRUSTED_HOSTS=domainanda.com,www.domainanda.com
LOGIN_RATE_LIMIT=5 per minute
# Rate limiting: MUST use Redis for multi-worker Gunicorn production.
# memory:// ONLY works for single-worker dev mode.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1
STRICT_PRODUCTION_DB_URL=1

OFFSITE_BACKUP_ENABLED=0
OFFSITE_BACKUP_PROVIDER=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=

LOG_ROOT=/var/log/idha-boga
APP_LOG_FILE=/var/log/idha-boga/app.log
ERROR_LOG_FILE=/var/log/idha-boga/error.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
SLOW_QUERY_LOGGING_ENABLED=1
SLOW_QUERY_THRESHOLD_MS=500
PORTAL_ENABLED=0
HEALTH_DISK_MIN_FREE_BYTES=1073741824
HEALTH_REQUIRE_VERIFIED_BACKUP=0
HEALTH_REQUIRE_POSTGRES_IN_PRODUCTION=1
PROXY_HEADERS_ENABLED=1
MAX_CONTENT_LENGTH=5242880
